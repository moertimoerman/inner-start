# Public app URL (use http://localhost:3000 locally and https://inner.help in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication (install through the Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registreren

# Stripe (all values must come from the same test/live mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=

# Private Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Optional: only for local voice production; never needed for customer playback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
